{
  "name": "alecho-pesca",
  "version": "1.0.0",
  "description": "Tienda de artículos de pesca Alecho Pesca - Fixed sessions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "init-admin": "node scripts/init-admin.js",
    "db:sync": "node scripts/db-sync.js",
    "db:migrate": "node scripts/migrations/migrate-to-postgresql.js",
    "mp:test": "node -e \"const mp = require('./services/mercadopagoService'); console.log('Mercado Pago configurado:', mp.isConfigured())\""
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mercadopago": "^2.12.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.4",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "http-cookie-agent": "^7.0.3",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tough-cookie": "^6.0.1"
  }
}
