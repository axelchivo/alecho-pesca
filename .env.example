# Variables de entorno para Alecho Pesca
# Copiar a .env y modificar según tu entorno

PORT=3000
NODE_ENV=development
SESSION_SECRET=algunaClaveSuperSecreta

# Tipo de base de datos: json, sqlite o postgresql
DB_TYPE=postgresql

# Si cambias la carpeta de datos, asegúrate que exista (solo para json/sqlite)
DATA_DIR=./data

# Configuración de PostgreSQL (requerido si DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alecho_pesca
DB_USER=postgres
DB_PASSWORD=tu-contraseña-postgres

# Configuración de MongoDB para sesiones (requerido en producción)
MONGO_URL=mongodb://127.0.0.1:27017/alecho_pesca_sessions

# Configuración de Mercado Pago (opcional)
# MERCADOPAGO_ACCESS_TOKEN=tu-access-token
# MERCADOPAGO_PUBLIC_KEY=tu-public-key
